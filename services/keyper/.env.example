# QoreChain testnet (qorechain-diana, EVM chain id 9800)
RPC_URL=https://evm-testnet.qore.host
PRIVATE_KEY=0x...
# at least 12 chars — encrypts every sealer key on disk
KEYPER_PASSPHRASE=

# optional: otherwise read from contracts/deployments/<chainId>.json
BLINDSPOT_ADDRESS=
FROM_BLOCK=
KEYS_DIR=./keys
POLL_MS=15000
# public RPCs cap eth_getLogs ranges
LOG_CHUNK=5000

# QoreChain: every EVM write needs a registered ML-DSA-87 key + an open EVM window.
# Run `pnpm account init` / `pnpm account register` once for this PRIVATE_KEY; the keyper
# then opens and renews its own windows.
PQC_RECOVERY_CODE=
# window the keyper opens (max 17280 blocks / 1000 txs); value = cap on fees, in QOR
KEYPER_WINDOW_BLOCKS=17280
KEYPER_WINDOW_TXS=1000
KEYPER_WINDOW_QOR=50
